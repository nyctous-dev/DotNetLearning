@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Rendering and Interop</PageTitle>

<h1>Rendering, Performance & JavaScript Interop</h1>

<p>
    Simulation tick: @_tickCount
    <span class="status">Timer active: @_timerActive</span>
</p>

<div class="controls">
    <button @onclick="AdvanceOneStep">Advance one step</button>
</div>

@if (_viewport is not null)
{
    <p>
        Browser viewport: @_viewport.Width * @_viewport.Height pixels
    </p>
}
else
{
    <p>Reading browser viewport…</p>
}

<div class="simulation-board" aria-label="Moving point simulation">
    @foreach (BoidPoint point in _points)
    {
        <div @key="point.Id"
             class="simulation-point"
             style="@GetPointStyle(point)"
             title="@($"Point {point.Id}: ({point.X:F1}, {point.Y:F1})")">
            @point.Id
        </div>
    }
</div>

<h2>Point coordinates</h2>

<div class="point-list">
    @foreach (BoidPoint point in _points)
    {
        <PointDetails @key="point.Id" Point="point" />
    }
</div>

@code {
    private List<BoidPoint> _points =
        Enumerable.Range(1, 16)
            .Select(id => new BoidPoint(
                id,
                5 + (id * 7 % 90),
                5 + (id * 13 % 90),
                id % 2 == 0 ? 20.0 : -20.0,
                id % 3 == 0 ? -20.0 : 20.0))
            .ToList();

    private int _tickCount;
    private bool _timerActive;
    private bool _disposed;

    private IJSObjectReference? _module;
    private ViewportDimensions? _viewport;
    private CancellationTokenSource? _timerCancellation;
    private Task? _timerTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Browser APIs are accessed after the interactive component renders,
        // not during initialization or static prerendering.
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/viewport.js");

            _viewport = await _module.InvokeAsync<ViewportDimensions>(
                "getViewportSize");

            // OnAfterRenderAsync completing does not itself schedule a render.
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException)
        {
            // The server-side browser connection has already ended.
            return;
        }

        _timerCancellation = new CancellationTokenSource();
        _timerActive = true;
        _timerTask = RunTimerAsync(_timerCancellation.Token);
    }

    private void AdvanceOneStep()
    {
        // Blazor schedules a render after this ordinary event handler.
        AdvanceSimulation();
    }

    private void AdvanceSimulation()
    {
        const double deltaTime = 0.033;

        _points = _points.Select(point =>
        {
            double x = point.X + point.Vx * deltaTime;
            double y = point.Y + point.Vy * deltaTime;

            double vx = point.Vx;
            double vy = point.Vy;

            if (x < 0)
            {
                x = -x;
                vx = Math.Abs(vx);
            }
            else if (x > 100)
            {
                x = 200 - x;
                vx = -Math.Abs(vx);
            }

            if (y < 0)
            {
                y = -y;
                vy = Math.Abs(vy);
            }
            else if (y > 100)
            {
                y = 200 - y;
                vy = -Math.Abs(vy);
            }

            return point with
            {
                X = x,
                Y = y,
                Vx = vx,
                Vy = vy
            };
        }).ToList();

        _tickCount++;
    }

    private async Task RunTimerAsync(CancellationToken cancellationToken)
    {
        try
        {
            using PeriodicTimer timer =
                new(TimeSpan.FromMilliseconds(33));

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    if (_disposed)
                    {
                        return;
                    }

                    AdvanceSimulation();

                    // Timer callbacks are external to Blazor's normal
                    // event pipeline, so explicitly request a render.
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
            // Normal timer shutdown during component disposal.
        }
        catch (ObjectDisposedException)
            when (cancellationToken.IsCancellationRequested)
        {
            // The renderer may already be shutting down.
        }
    }

    private static double Wrap(double value) =>
        ((value % 100) + 100) % 100;

    private static string GetPointStyle(BoidPoint point) =>
        $"left: {point.X:F1}%; top: {point.Y:F1}%;";

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _timerActive = false;

        if (_timerCancellation is not null)
        {
            await _timerCancellation.CancelAsync();

            if (_timerTask is not null)
            {
                await _timerTask;
            }

            _timerCancellation.Dispose();
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser connection is already gone.
            }
        }
    }

    private sealed class ViewportDimensions
    {
        public int Width { get; set; }
        public int Height { get; set; }
    }
}