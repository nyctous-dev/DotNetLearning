<div>
    <label for="movement-speed">Movement speed</label>
    <input id="movement-speed"
           type="number"
           min="0"
           step="0.1"
           @bind:get="Speed"
           @bind:set="SetSpeedAsync"
           @bind:event="oninput" />
</div>

@code {
    [Parameter]
    public double Speed { get; set; }

    [Parameter]
    public EventCallback<double> SpeedChanged { get; set; }

    private Task SetSpeedAsync(double value)
    {
        if (!double.IsFinite(value) || value < 0)
        {
            return Task.CompletedTask;
        }

        return SpeedChanged.InvokeAsync(value);
    }
}