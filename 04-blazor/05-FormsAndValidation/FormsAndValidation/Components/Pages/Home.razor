@page "/"

<PageTitle>Forms &amp; Validation</PageTitle>

<h1>Forms &amp; Validation</h1>

<p>
    Configure a simulation. Invalid values must be corrected before
    the settings can be accepted.
</p>

<EditForm Model="@settings"
          OnValidSubmit="@HandleValidSubmit"
          OnInvalidSubmit="@HandleInvalidSubmit">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="simulation-name" class="form-label">
            Simulation name
        </label>
        <InputText id="simulation-name"
                   class="form-control"
                   @bind-Value="settings.Name" />
        <ValidationMessage For="@(() => settings.Name)" />
    </div>

    <div class="mb-3">
        <label for="boid-count" class="form-label">
            Boid count
        </label>
        <InputNumber id="boid-count"
                     class="form-control"
                     @bind-Value="settings.BoidCount" />
        <ValidationMessage For="@(() => settings.BoidCount)" />
    </div>

    <div class="mb-3">
        <label for="movement-speed" class="form-label">
            Movement speed
        </label>
        <InputNumber id="movement-speed"
                     class="form-control"
                     @bind-Value="settings.MovementSpeed" />
        <ValidationMessage For="@(() => settings.MovementSpeed)" />
        <small>Allowed range: 0.1–10.0 inclusive.</small>
    </div>

    <button type="submit" class="btn btn-primary">
        Save settings
    </button>

    <button type="button"
            class="btn btn-secondary ms-2"
            @onclick="ResetForm">
        Reset
    </button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p class="mt-3" role="status">@statusMessage</p>
}

@if (submittedSettings is not null)
{
    <section class="mt-4">
        <h2>Accepted configuration</h2>
        <dl>
            <dt>Simulation name</dt>
            <dd>@submittedSettings.Name</dd>

            <dt>Boid count</dt>
            <dd>@submittedSettings.BoidCount</dd>

            <dt>Movement speed</dt>
            <dd>@submittedSettings.MovementSpeed</dd>
        </dl>
    </section>
}

@code {
    private SimulationSettings settings = new();
    private SimulationSettings? submittedSettings;
    private string? statusMessage;

    private void HandleValidSubmit()
    {
        // This handler runs only after the EditForm validation succeeds.
        // A real API or server-side service must validate again at its boundary.
        submittedSettings = new SimulationSettings
        {
            Name = settings.Name,
            BoidCount = settings.BoidCount,
            MovementSpeed = settings.MovementSpeed
        };

        statusMessage = "Settings accepted.";
    }

    private void HandleInvalidSubmit()
    {
        submittedSettings = null;
        statusMessage = "Settings were not accepted. Correct the validation errors.";
    }

    private void ResetForm()
    {
        settings = new SimulationSettings();
        submittedSettings = null;
        statusMessage = null;
    }
}