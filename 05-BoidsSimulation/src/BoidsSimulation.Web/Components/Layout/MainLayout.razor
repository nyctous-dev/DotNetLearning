@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inherits LayoutComponentBase
@implements IAsyncDisposable

@inject IJSRuntime JS
@inject ILogger<MainLayout> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BoidsSimulation.Web.Services.SimulationPreferencesService PreferencesService
@inject BoidsSimulation.Web.Services.SimulationConnectionStatus ConnectionStatus
@inject BoidsSimulation.Web.Services.SimulationVisualPreferencesState VisualPreferences

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="/simulation" aria-label="FLOCK home">
            <span class="brand-mark" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </span>

            <span class="brand-copy">
                <span class="brand-name">FLOCK</span>
                <span class="brand-caption">SHARED SIMULATION</span>
            </span>

            <span
                class="connection-status @($"is-{ConnectionStatus.Status.ToLowerInvariant()}")"
                role="status"
                aria-label="@($"Simulation connection: {ConnectionStatus.Status}")"
                title="@ConnectionStatus.Status">
                <span class="connection-dot"></span>
            </span>
        </a>

        <div class="header-actions">
            <details class="header-menu" name="header-menu">
                <summary>
                    <span class="menu-icon" aria-hidden="true">◈</span>
                    Appearance
                    <span class="chevron" aria-hidden="true"></span>
                </summary>

                <div class="dropdown-panel appearance-panel">
                    <div class="panel-heading">
                        <span class="panel-eyebrow">PERSONALIZE</span>
                        <h2>Visual settings</h2>
                    </div>

                    <label class="setting-field color-setting" for="boid-color">
                        <span>Boid color</span>
                        <input
                            id="boid-color"
                            name="boid-color"
                            type="color"
                            value="@VisualPreferences.Current.BoidColor"
                            @onchange="OnBoidColorChanged" />
                    </label>

                    <label class="setting-field color-setting" for="background-color">
                        <span>Background color</span>
                        <input
                            id="background-color"
                            name="background-color"
                            type="color"
                            value="@VisualPreferences.Current.BackgroundColor"
                            @onchange="OnBackgroundColorChanged" />
                    </label>

                    <label class="check-setting" for="show-trails">
                        <span>
                            <strong>Motion trails</strong>
                            <small>Show movement history</small>
                        </span>

                        <input
                            id="show-trails"
                            name="show-trails"
                            type="checkbox"
                            checked="@VisualPreferences.Current.ShowTrails"
                            @onchange="OnShowTrailsChanged" />
                    </label>

                    <p class="panel-note">
                        Changes apply immediately to this simulation.
                        Signed-in users' preferences are saved to their accounts.
                    </p>
                </div>
            </details>

            <AuthorizeView>
                <Authorized>
                    <details class="header-menu" name="header-menu">
                        <summary>
                            <span class="menu-icon" aria-hidden="true">◎</span>
                            Interaction
                            <span class="chevron" aria-hidden="true"></span>
                        </summary>

                        <div class="dropdown-panel interaction-panel">
                            <div class="panel-heading">
                                <span class="panel-eyebrow">BOID BEHAVIOR</span>
                                <h2>Mouse controls</h2>
                            </div>

                            <fieldset class="action-setting">
                                <legend>Middle mouse action</legend>

                                <div class="segmented-control">
                                    <input
                                        type="radio"
                                        id="middle-mouse-repel"
                                        name="middle-mouse-action"
                                        value="Repel"
                                        checked="@(_interactionMode == "Repel")"
                                        @onchange="OnInteractionModeChanged" />

                                    <label for="middle-mouse-repel">
                                        Repel
                                    </label>

                                    <input
                                        type="radio"
                                        id="middle-mouse-attract"
                                        name="middle-mouse-action"
                                        value="Attract"
                                        checked="@(_interactionMode == "Attract")"
                                        @onchange="OnInteractionModeChanged" />

                                    <label for="middle-mouse-attract">
                                        Attract
                                    </label>
                                </div>
                            </fieldset>

                            <p class="panel-note">
                                Hold the middle mouse button over the simulation
                                to apply the selected action. Release it to stop.
                            </p>
                        </div>
                    </details>
                </Authorized>
            </AuthorizeView>

            <span class="header-divider" aria-hidden="true"></span>

            <AuthorizeView>
                <Authorized>
                    <a
                        class="sign-in-button"
                        href="/Identity/Account/Logout?returnUrl=%2Fsimulation"
                        title="Sign out">
                        Sign out
                    </a>
                </Authorized>

                <NotAuthorized>
                    <a
                        class="sign-in-button"
                        href="/Identity/Account/Login?returnUrl=%2Fsimulation">
                        <span class="user-icon" aria-hidden="true">↗</span>
                        Sign in
                    </a>

                    <a
                        class="register-button"
                        href="/Identity/Account/Register?returnUrl=%2Fsimulation">
                        Create account
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

@code {
    private IJSObjectReference? _simulationModule;

    private string _interactionMode = "Repel";

    // A scoped EF Core DbContext must not service concurrent operations.
    // Serialize preference saves and save the most recent state each time.
    private readonly SemaphoreSlim _preferenceSaveLock = new(1, 1);

    protected override void OnInitialized()
    {
        ConnectionStatus.Changed += HandleConnectionStatusChanged;
        VisualPreferences.Changed += HandleVisualPreferencesChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthenticatedPreferencesAsync();
    }

    private async Task LoadAuthenticatedPreferencesAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var principal = authenticationState.User;

            if (principal.Identity?.IsAuthenticated != true)
            {
                return;
            }

            var saved = await PreferencesService.GetAsync(principal);

            // Applying loaded values updates the shared in-memory state.
            // This does not invoke the UI's save handlers.
            VisualPreferences.SetBoidColor(saved.BoidColor);
            VisualPreferences.SetBackgroundColor(saved.BackgroundColor);
            VisualPreferences.SetShowTrails(saved.ShowTrails);

            Logger.LogDebug(
                "Loaded visual preferences for the authenticated user.");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load the authenticated user's simulation preferences.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _simulationModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/simulationClient.js");

            await _simulationModule.InvokeVoidAsync(
                "setInteractionMode",
                _interactionMode);
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit disconnected during initialization.
        }
        catch (JSException exception)
        {
            Logger.LogError(
                exception,
                "Failed to initialize the simulation interaction mode.");
        }
    }

    private void HandleConnectionStatusChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleVisualPreferencesChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnBoidColorChanged(ChangeEventArgs args)
    {
        VisualPreferences.SetBoidColor(args.Value?.ToString());

        await SavePreferencesIfAuthenticatedAsync();
    }

    private async Task OnBackgroundColorChanged(ChangeEventArgs args)
    {
        VisualPreferences.SetBackgroundColor(args.Value?.ToString());

        await SavePreferencesIfAuthenticatedAsync();
    }

    private async Task OnShowTrailsChanged(ChangeEventArgs args)
    {
        if (!bool.TryParse(args.Value?.ToString(), out var showTrails))
        {
            return;
        }

        VisualPreferences.SetShowTrails(showTrails);

        await SavePreferencesIfAuthenticatedAsync();
    }

    private async Task SavePreferencesIfAuthenticatedAsync()
    {
        await _preferenceSaveLock.WaitAsync();

        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var principal = authenticationState.User;

            // Guests do not have an account record to update.
            if (principal.Identity?.IsAuthenticated != true)
            {
                return;
            }

            // Read Current only after acquiring the lock, so we persist
            // the latest state rather than an outdated event's values.
            var current = VisualPreferences.Current;

            var preferences = new BoidsSimulation.Web.Services
                .SimulationPreferences(
                    current.BoidColor,
                    current.BackgroundColor,
                    current.ShowTrails);

            await PreferencesService.SaveAsync(
                principal,
                preferences);

            Logger.LogDebug(
                "Saved simulation visual preferences for the authenticated user.");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to save the authenticated user's simulation preferences.");
        }
        finally
        {
            _preferenceSaveLock.Release();
        }
    }

    private async Task OnInteractionModeChanged(ChangeEventArgs args)
    {
        var selectedMode = args.Value?.ToString();

        if (selectedMode is not ("Attract" or "Repel") ||
            _interactionMode == selectedMode)
        {
            return;
        }

        var previousMode = _interactionMode;
        _interactionMode = selectedMode;

        try
        {
            _simulationModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/simulationClient.js");

            await _simulationModule.InvokeVoidAsync(
                "setInteractionMode",
                _interactionMode);
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit disconnected while applying the selection.
        }
        catch (JSException exception)
        {
            _interactionMode = previousMode;

            Logger.LogError(
                exception,
                "Failed to change the simulation interaction mode.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        ConnectionStatus.Changed -= HandleConnectionStatusChanged;
        VisualPreferences.Changed -= HandleVisualPreferencesChanged;

        if (_simulationModule is not null)
        {
            try
            {
                await _simulationModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit is already disconnected.
            }
        }
    }
}