﻿@using Microsoft.AspNetCore.Components.Authorization
@using BoidsSimulation.Application.Settings
@using Microsoft.JSInterop
@using BoidsSimulation.Core.Models
@inherits LayoutComponentBase
@implements IAsyncDisposable

@inject IJSRuntime JS
@inject ILogger<MainLayout> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BoidsSimulation.Web.Services.SimulationPreferencesService PreferencesService
@inject BoidsSimulation.Web.Services.SimulationConnectionStatus ConnectionStatus
@inject BoidsSimulation.Web.Services.SimulationVisualPreferencesState VisualPreferences
@inject SimulationLimits SimulationLimits

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="/simulation" aria-label="FLOCK home">
            <span class="brand-mark" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </span>

            <span class="brand-copy">
                <span class="brand-name">FLOCK</span>
                <span class="brand-caption">SHARED SIMULATION</span>
            </span>

            <span
                class="connection-status @($"is-{ConnectionStatus.Status.ToLowerInvariant()}")"
                role="status"
                aria-label="@($"Simulation connection: {ConnectionStatus.Status}")"
                title="@ConnectionStatus.Status">
                <span class="connection-dot"></span>
            </span>
        </a>

        <div class="header-actions">
            <details class="header-menu" name="header-menu">
                <summary>
                    <span class="menu-icon" aria-hidden="true">◈</span>
                    Appearance
                    <span class="chevron" aria-hidden="true"></span>
                </summary>

                <div class="dropdown-panel appearance-panel">
                    <div class="panel-heading">
                        <span class="panel-eyebrow">PERSONALIZE</span>
                        <h2>Visual settings</h2>
                    </div>

                    <label class="setting-field color-setting" for="boid-color">
                        <span>Boid color</span>
                        <input
                            id="boid-color"
                            name="boid-color"
                            type="color"
                            value="@VisualPreferences.Current.BoidColor"
                            @onchange="OnBoidColorChanged" />
                    </label>

                    <label class="setting-field color-setting" for="background-color">
                        <span>Background color</span>
                        <input
                            id="background-color"
                            name="background-color"
                            type="color"
                            value="@VisualPreferences.Current.BackgroundColor"
                            @onchange="OnBackgroundColorChanged" />
                    </label>

                    <label class="check-setting" for="show-trails">
                        <span>
                            <strong>Motion trails</strong>
                            <small>Show movement history</small>
                        </span>

                        <input
                            id="show-trails"
                            name="show-trails"
                            type="checkbox"
                            checked="@VisualPreferences.Current.ShowTrails"
                            @onchange="OnShowTrailsChanged" />
                    </label>

                    <p class="panel-note">
                        Changes apply immediately to this simulation.
                        Signed-in users' preferences are saved to their accounts.
                    </p>
                </div>
            </details>

            <AuthorizeView>
                <Authorized>
                    <details class="header-menu" name="header-menu">
                        <summary>
                            <span class="menu-icon" aria-hidden="true">◎</span>
                            Interaction
                            <span class="chevron" aria-hidden="true"></span>
                        </summary>

                        <div class="dropdown-panel interaction-panel">
                            <div class="panel-heading">
                                <span class="panel-eyebrow">BOID BEHAVIOR</span>
                                <h2>Mouse controls</h2>
                            </div>

                            <fieldset class="action-setting">
                                <legend>Middle mouse action</legend>

                                <div class="segmented-control">
                                    <input
                                        type="radio"
                                        id="middle-mouse-repel"
                                        name="middle-mouse-action"
                                        value="Repel"
                                        checked="@(_interactionMode == "Repel")"
                                        @onchange="OnInteractionModeChanged" />

                                    <label for="middle-mouse-repel">
                                        Repel
                                    </label>

                                    <input
                                        type="radio"
                                        id="middle-mouse-attract"
                                        name="middle-mouse-action"
                                        value="Attract"
                                        checked="@(_interactionMode == "Attract")"
                                        @onchange="OnInteractionModeChanged" />

                                    <label for="middle-mouse-attract">
                                        Attract
                                    </label>
                                </div>
                            </fieldset>

                            <p class="panel-note">
                                Hold the middle mouse button over the simulation
                                to apply the selected action. Release it to stop.
                            </p>
                        </div>
                    </details>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <details class="header-menu" name="header-menu">
                        <summary>
                            <span class="menu-icon" aria-hidden="true">⚙</span>
                            Admin
                            <span class="chevron" aria-hidden="true"></span>
                        </summary>

                        <div class="dropdown-panel admin-settings-panel">
                            <div class="panel-heading">
                                <span class="panel-eyebrow">GLOBAL CONTROLS</span>
                                <h2>Simulation behavior</h2>
                            </div>

                            <p class="panel-note admin-intro">
                                These settings affect the shared simulation for every connected user.
                                Adjust the sliders, then apply the changes.
                            </p>

                            <button
                                type="button"
                                class="panel-action"
                                disabled="@_settingsLoading"
                                @onclick="LoadBehaviorSettingsAsync">
                                @(_settingsLoading ? "Loading settings…" : "Load current settings")
                            </button>

                            @if (!string.IsNullOrWhiteSpace(_settingsMessage))
                            {
                                <p class="admin-settings-message @(_settingsMessageIsError ? "is-error" : "")" role="status">
                                    @_settingsMessage
                                </p>
                            }

                            @if (_hasLoadedSettings)
                            {
                                <div class="admin-slider-list">
                                    <label class="admin-slider" for="admin-separation-radius">
                                        <span><span>Separation radius</span><strong>@_settingsEditor.SeparationRadius.ToString("0.##")</strong></span>
                                        <input id="admin-separation-radius" type="range" min="@SimulationLimits.SeparationRadius.Min" max="@SimulationLimits.SeparationRadius.Max" step="0.1" @bind="_settingsEditor.SeparationRadius" @bind:event="oninput" />
                                    </label>

                                    <label class="admin-slider" for="admin-alignment-radius">
                                        <span><span>Alignment radius</span><strong>@_settingsEditor.AlignmentRadius.ToString("0.##")</strong></span>
                                        <input id="admin-alignment-radius" type="range" min="@SimulationLimits.AlignmentRadius.Min" max="@SimulationLimits.AlignmentRadius.Max" step="0.1" @bind="_settingsEditor.AlignmentRadius" @bind:event="oninput" />
                                    </label>

                                    <label class="admin-slider" for="admin-cohesion-radius">
                                        <span><span>Cohesion radius</span><strong>@_settingsEditor.CohesionRadius.ToString("0.##")</strong></span>
                                        <input id="admin-cohesion-radius" type="range" min="@SimulationLimits.CohesionRadius.Min" max="@SimulationLimits.CohesionRadius.Max" step="0.1" @bind="_settingsEditor.CohesionRadius" @bind:event="oninput" />
                                    </label>

                                    <label class="admin-slider" for="admin-separation-weight">
                                        <span><span>Separation weight</span><strong>@_settingsEditor.SeparationWeight.ToString("0.##")</strong></span>
                                        <input id="admin-separation-weight" type="range" min="@SimulationLimits.SeparationWeight.Min" max="@SimulationLimits.SeparationWeight.Max" step="0.1" @bind="_settingsEditor.SeparationWeight" @bind:event="oninput" />
                                    </label>

                                    <label class="admin-slider" for="admin-alignment-weight">
                                        <span><span>Alignment weight</span><strong>@_settingsEditor.AlignmentWeight.ToString("0.##")</strong></span>
                                        <input id="admin-alignment-weight" type="range" min="@SimulationLimits.AlignmentWeight.Min" max="@SimulationLimits.AlignmentWeight.Max" step="0.1" @bind="_settingsEditor.AlignmentWeight" @bind:event="oninput" />
                                    </label>

                                    <label class="admin-slider" for="admin-cohesion-weight">
                                        <span><span>Cohesion weight</span><strong>@_settingsEditor.CohesionWeight.ToString("0.##")</strong></span>
                                        <input id="admin-cohesion-weight" type="range" min="@SimulationLimits.CohesionWeight.Min" max="@SimulationLimits.CohesionWeight.Max" step="0.1" @bind="_settingsEditor.CohesionWeight" @bind:event="oninput" />
                                    </label>

                                    <label class="admin-slider" for="admin-max-speed">
                                        <span><span>Maximum speed</span><strong>@_settingsEditor.MaxSpeed.ToString("0.##")</strong></span>
                                        <input id="admin-max-speed" type="range" min="@SimulationLimits.MaxSpeed.Min" max="@SimulationLimits.MaxSpeed.Max" step="1" @bind="_settingsEditor.MaxSpeed" @bind:event="oninput" />
                                    </label>

                                    <label class="admin-slider" for="admin-max-steering-force">
                                        <span><span>Maximum steering force</span><strong>@_settingsEditor.MaxSteeringForce.ToString("0.##")</strong></span>
                                        <input id="admin-max-steering-force" type="range" min="@SimulationLimits.MaxSteeringForce.Min" max="@SimulationLimits.MaxSteeringForce.Max" step="1" @bind="_settingsEditor.MaxSteeringForce" @bind:event="oninput" />
                                    </label>

                                    <label class="admin-slider" for="admin-wander-strength">
                                        <span><span>Wander strength</span><strong>@_settingsEditor.WanderStrength.ToString("0.##")</strong></span>
                                        <input id="admin-wander-strength" type="range" min="@SimulationLimits.WanderStrength.Min" max="@SimulationLimits.WanderStrength.Max" step="0.1" @bind="_settingsEditor.WanderStrength" @bind:event="oninput" />
                                    </label>

                                    <label class="admin-slider" for="admin-attraction-force">
                                        <span><span>Attraction force</span><strong>@_settingsEditor.AttractionForce.ToString("0.##")</strong></span>
                                        <input id="admin-attraction-force" type="range" min="@SimulationLimits.AttractionForce.Min" max="@SimulationLimits.AttractionForce.Max" step="1" @bind="_settingsEditor.AttractionForce" @bind:event="oninput" />
                                    </label>

                                    <label class="admin-slider" for="admin-repulsion-force">
                                        <span><span>Repulsion force</span><strong>@_settingsEditor.RepulsionForce.ToString("0.##")</strong></span>
                                        <input id="admin-repulsion-force" type="range" min="@SimulationLimits.RepulsionForce.Min" max="@SimulationLimits.RepulsionForce.Max" step="1" @bind="_settingsEditor.RepulsionForce" @bind:event="oninput" />
                                    </label>

                                    <label class="admin-slider" for="admin-interaction-radius">
                                        <span><span>Interaction radius</span><strong>@_settingsEditor.InteractionRadius.ToString("0.##")</strong></span>
                                        <input id="admin-interaction-radius" type="range" min="@SimulationLimits.InteractionRadius.Min" max="@SimulationLimits.InteractionRadius.Max" step="1" @bind="_settingsEditor.InteractionRadius" @bind:event="oninput" />
                                    </label>
                                </div>

                                <button
                                    type="button"
                                    class="panel-action apply-settings-action"
                                    disabled="@(_settingsLoading || _settingsSaving)"
                                    @onclick="ApplyBehaviorSettingsAsync">
                                    @(_settingsSaving ? "Applying changes…" : "Apply settings to all users")
                                </button>
                            }
                        </div>
                    </details>
                </Authorized>
            </AuthorizeView>

            <span class="header-divider" aria-hidden="true"></span>

            <AuthorizeView>
                <Authorized>
                    <a
                        class="sign-in-button"
                        href="/Identity/Account/Logout?returnUrl=%2Fsimulation"
                        title="Sign out">
                        Sign out
                    </a>
                </Authorized>

                <NotAuthorized>
                    <a
                        class="sign-in-button"
                        href="/Identity/Account/Login?returnUrl=%2Fsimulation">
                        <span class="user-icon" aria-hidden="true">↗</span>
                        Sign in
                    </a>

                    <a
                        class="register-button"
                        href="/Identity/Account/Register?returnUrl=%2Fsimulation">
                        Create account
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

@code {
    private IJSObjectReference? _simulationModule;

    private string _interactionMode = "Repel";

    private readonly SettingsEditorModel _settingsEditor = new();
    private DotNetObjectReference<MainLayout>? _settingsDotNetReference;
    private bool _hasLoadedSettings;
    private bool _settingsLoading;
    private bool _settingsSaving;
    private bool _settingsMessageIsError;
    private string? _settingsMessage;

    // A scoped EF Core DbContext must not service concurrent operations.
    // Serialize preference saves and save the most recent state each time.
    private readonly SemaphoreSlim _preferenceSaveLock = new(1, 1);

    protected override void OnInitialized()
    {
        ConnectionStatus.Changed += HandleConnectionStatusChanged;
        VisualPreferences.Changed += HandleVisualPreferencesChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthenticatedPreferencesAsync();
    }

    private async Task LoadAuthenticatedPreferencesAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var principal = authenticationState.User;

            if (principal.Identity?.IsAuthenticated != true)
            {
                return;
            }

            var saved = await PreferencesService.GetAsync(principal);

            // Applying loaded values updates the shared in-memory state.
            // This does not invoke the UI's save handlers.
            VisualPreferences.SetBoidColor(saved.BoidColor);
            VisualPreferences.SetBackgroundColor(saved.BackgroundColor);
            VisualPreferences.SetShowTrails(saved.ShowTrails);

            Logger.LogDebug(
                "Loaded visual preferences for the authenticated user.");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load the authenticated user's simulation preferences.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _simulationModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/simulationClient.js");

            await _simulationModule.InvokeVoidAsync(
                "setInteractionMode",
                _interactionMode);

            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            if (authenticationState.User.IsInRole("Admin"))
            {
                _settingsDotNetReference = DotNetObjectReference.Create(this);

                await _simulationModule.InvokeVoidAsync(
                    "registerSettingsListener",
                    _settingsDotNetReference);
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit disconnected during initialization.
        }
        catch (JSException exception)
        {
            Logger.LogError(
                exception,
                "Failed to initialize the simulation interaction mode.");
        }
    }

    private void HandleConnectionStatusChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleVisualPreferencesChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnBoidColorChanged(ChangeEventArgs args)
    {
        VisualPreferences.SetBoidColor(args.Value?.ToString());

        await SavePreferencesIfAuthenticatedAsync();
    }

    private async Task OnBackgroundColorChanged(ChangeEventArgs args)
    {
        VisualPreferences.SetBackgroundColor(args.Value?.ToString());

        await SavePreferencesIfAuthenticatedAsync();
    }

    private async Task OnShowTrailsChanged(ChangeEventArgs args)
    {
        if (!bool.TryParse(args.Value?.ToString(), out var showTrails))
        {
            return;
        }

        VisualPreferences.SetShowTrails(showTrails);

        await SavePreferencesIfAuthenticatedAsync();
    }

    private async Task SavePreferencesIfAuthenticatedAsync()
    {
        await _preferenceSaveLock.WaitAsync();

        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var principal = authenticationState.User;

            // Guests do not have an account record to update.
            if (principal.Identity?.IsAuthenticated != true)
            {
                return;
            }

            // Read Current only after acquiring the lock, so we persist
            // the latest state rather than an outdated event's values.
            var current = VisualPreferences.Current;

            var preferences = new BoidsSimulation.Web.Services
                .SimulationPreferences(
                    current.BoidColor,
                    current.BackgroundColor,
                    current.ShowTrails);

            await PreferencesService.SaveAsync(
                principal,
                preferences);

            Logger.LogDebug(
                "Saved simulation visual preferences for the authenticated user.");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to save the authenticated user's simulation preferences.");
        }
        finally
        {
            _preferenceSaveLock.Release();
        }
    }

    private async Task OnInteractionModeChanged(ChangeEventArgs args)
    {
        var selectedMode = args.Value?.ToString();

        if (selectedMode is not ("Attract" or "Repel") ||
            _interactionMode == selectedMode)
        {
            return;
        }

        var previousMode = _interactionMode;
        _interactionMode = selectedMode;

        try
        {
            _simulationModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/simulationClient.js");

            await _simulationModule.InvokeVoidAsync(
                "setInteractionMode",
                _interactionMode);
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit disconnected while applying the selection.
        }
        catch (JSException exception)
        {
            _interactionMode = previousMode;

            Logger.LogError(
                exception,
                "Failed to change the simulation interaction mode.");
        }
    }

    private async Task LoadBehaviorSettingsAsync()
    {
        _settingsLoading = true;
        _settingsMessage = null;
        _settingsMessageIsError = false;

        try
        {
            _simulationModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/simulationClient.js");

            var settings = await _simulationModule.InvokeAsync<SimulationBehaviorSettings>(
                "getBehaviorSettings");

            _settingsEditor.CopyFrom(settings);
            _hasLoadedSettings = true;
            _settingsMessage = "Current shared settings loaded.";
        }
        catch (JSDisconnectedException)
        {
            _settingsMessage = "The browser connection was interrupted. Try loading settings again.";
            _settingsMessageIsError = true;
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not load runtime simulation settings.");
            _settingsMessage = "The simulation connection is not ready. Try loading again in a moment.";
            _settingsMessageIsError = true;
        }
        finally
        {
            _settingsLoading = false;
        }
    }

    private async Task ApplyBehaviorSettingsAsync()
    {
        _settingsSaving = true;
        _settingsMessage = null;
        _settingsMessageIsError = false;

        try
        {
            _simulationModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/simulationClient.js");

            var updatedSettings = await _simulationModule.InvokeAsync<SimulationBehaviorSettings>(
                "updateBehaviorSettings",
                _settingsEditor.ToBehaviorSettings());

            _settingsEditor.CopyFrom(updatedSettings);
            _settingsMessage = "Settings applied to the shared simulation.";
        }
        catch (JSDisconnectedException)
        {
            _settingsMessage = "The browser connection was interrupted. Try applying the settings again.";
            _settingsMessageIsError = true;
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not apply runtime simulation settings.");
            _settingsMessage = "The server rejected the settings or the simulation connection is not ready.";
            _settingsMessageIsError = true;
        }
        finally
        {
            _settingsSaving = false;
        }
    }

    [JSInvokable]
    public Task OnSimulationSettingsUpdated(SimulationBehaviorSettings settings)
    {
        return InvokeAsync(() =>
        {
            _settingsEditor.CopyFrom(settings);
            _hasLoadedSettings = true;

            if (!_settingsSaving)
            {
                _settingsMessage = "Shared settings were updated by an administrator.";
                _settingsMessageIsError = false;
            }

            StateHasChanged();
        });
    }

    private sealed class SettingsEditorModel
    {
        public float SeparationRadius { get; set; }
        public float AlignmentRadius { get; set; }
        public float CohesionRadius { get; set; }
        public float SeparationWeight { get; set; }
        public float AlignmentWeight { get; set; }
        public float CohesionWeight { get; set; }
        public float MaxSpeed { get; set; }
        public float MaxSteeringForce { get; set; }
        public float WanderStrength { get; set; }
        public float AttractionForce { get; set; }
        public float RepulsionForce { get; set; }
        public float InteractionRadius { get; set; }

        public void CopyFrom(SimulationBehaviorSettings settings)
        {
            SeparationRadius = settings.SeparationRadius;
            AlignmentRadius = settings.AlignmentRadius;
            CohesionRadius = settings.CohesionRadius;
            SeparationWeight = settings.SeparationWeight;
            AlignmentWeight = settings.AlignmentWeight;
            CohesionWeight = settings.CohesionWeight;
            MaxSpeed = settings.MaxSpeed;
            MaxSteeringForce = settings.MaxSteeringForce;
            WanderStrength = settings.WanderStrength;
            AttractionForce = settings.AttractionForce;
            RepulsionForce = settings.RepulsionForce;
            InteractionRadius = settings.InteractionRadius;
        }

        public SimulationBehaviorSettings ToBehaviorSettings()
        {
            return new SimulationBehaviorSettings(
                SeparationRadius,
                AlignmentRadius,
                CohesionRadius,
                SeparationWeight,
                AlignmentWeight,
                CohesionWeight,
                MaxSpeed,
                MaxSteeringForce,
                WanderStrength,
                AttractionForce,
                RepulsionForce,
                InteractionRadius);
        }
    }

    public async ValueTask DisposeAsync()
    {
        ConnectionStatus.Changed -= HandleConnectionStatusChanged;
        VisualPreferences.Changed -= HandleVisualPreferencesChanged;

        if (_simulationModule is not null)
        {
            try
            {
                await _simulationModule.InvokeVoidAsync("clearSettingsListener");
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit is already disconnected.
            }

            try
            {
                await _simulationModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit is already disconnected.
            }
        }

        _settingsDotNetReference?.Dispose();
    }
}