@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@implements IDisposable
@inject BoidsSimulation.Web.Services.SimulationConnectionStatus ConnectionStatus

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="/simulation" aria-label="FLOCK home">
            <span class="brand-mark" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </span>

            <span class="brand-copy">
                <span class="brand-name">FLOCK</span>
                <span class="brand-caption">SHARED SIMULATION</span>
            </span>

            <span
                class="connection-status @($"is-{ConnectionStatus.Status.ToLowerInvariant()}")"
                role="status"
                aria-label="@($"Simulation connection: {ConnectionStatus.Status}")"
                title="@ConnectionStatus.Status">
                <span class="connection-dot"></span>
            </span>
        </a>

        <div class="header-actions">
            @* Appearance remains available to guests and signed-in users. *@
            <details class="header-menu" name="header-menu">
                <summary>
                    <span class="menu-icon" aria-hidden="true">◈</span>
                    Appearance
                    <span class="chevron" aria-hidden="true"></span>
                </summary>

                <div class="dropdown-panel appearance-panel">
                    <div class="panel-heading">
                        <span class="panel-eyebrow">PERSONALIZE</span>
                        <h2>Visual settings</h2>
                    </div>

                    <label class="setting-field" for="boid-color">
                        <span>Boid color</span>
                        <select id="boid-color" name="boid-color">
                            <option value="cyan">Electric cyan</option>
                            <option value="white">White</option>
                            <option value="amber">Amber</option>
                            <option value="green">Mint green</option>
                        </select>
                    </label>

                    <label class="setting-field" for="boid-size">
                        <span>Boid size</span>
                        <select id="boid-size" name="boid-size">
                            <option value="small">Small</option>
                            <option value="medium" selected>Medium</option>
                            <option value="large">Large</option>
                        </select>
                    </label>

                    <label class="check-setting" for="show-trails">
                        <span>
                            <strong>Motion trails</strong>
                            <small>Show movement history</small>
                        </span>
                        <input
                            id="show-trails"
                            name="show-trails"
                            type="checkbox" />
                    </label>

                    <p class="panel-note">
                        Visual settings will be connected to the renderer next.
                    </p>
                </div>
            </details>

            @* The entire interaction dropdown is restricted to signed-in users. *@
            <AuthorizeView>
                <Authorized>
                    <details class="header-menu" name="header-menu">
                        <summary>
                            <span class="menu-icon" aria-hidden="true">◎</span>
                            Interaction
                            <span class="chevron" aria-hidden="true"></span>
                        </summary>

                        <div class="dropdown-panel interaction-panel">
                            <div class="panel-heading">
                                <span class="panel-eyebrow">BOID BEHAVIOR</span>
                                <h2>Mouse controls</h2>
                            </div>

                            <fieldset class="action-setting">
                                <legend>Right-click action</legend>

                                <div class="segmented-control">
                                    <input
                                        type="radio"
                                        id="right-click-repel"
                                        name="right-click-action"
                                        value="repel"
                                        checked />
                                    <label for="right-click-repel">Repel</label>

                                    <input
                                        type="radio"
                                        id="right-click-attract"
                                        name="right-click-action"
                                        value="attract" />
                                    <label for="right-click-attract">Attract</label>
                                </div>
                            </fieldset>

                            <p class="panel-note">
                                The selected action will be used when mouse interactions
                                are connected to the simulation.
                            </p>
                        </div>
                    </details>
                </Authorized>
            </AuthorizeView>

            <span class="header-divider" aria-hidden="true"></span>

            <AuthorizeView>
                <Authorized>
                    <a
                        class="sign-in-button"
                        href="/Identity/Account/Logout?returnUrl=%2Fsimulation"
                        title="Sign out">
                        Sign out
                    </a>
                </Authorized>

                <NotAuthorized>
                    <a
                        class="sign-in-button"
                        href="/Identity/Account/Login?returnUrl=%2Fsimulation">
                        <span class="user-icon" aria-hidden="true">↗</span>
                        Sign in
                    </a>

                    <a
                        class="register-button"
                        href="/Identity/Account/Register?returnUrl=%2Fsimulation">
                        Create account
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        ConnectionStatus.Changed += HandleConnectionStatusChanged;
    }

    private void HandleConnectionStatusChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ConnectionStatus.Changed -= HandleConnectionStatusChanged;
    }
}
