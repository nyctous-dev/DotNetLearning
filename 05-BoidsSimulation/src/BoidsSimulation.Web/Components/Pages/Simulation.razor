@using BoidsSimulation.Core.Models
@page "/simulation"
@implements IAsyncDisposable

@inject IJSRuntime JS
@inject SimulationSettings Settings
@inject BoidsSimulation.Web.Services.SimulationConnectionStatus ConnectionStatus
@inject BoidsSimulation.Web.Services.SimulationVisualPreferencesState VisualPreferences

<section class="simulation-viewport" style="position: relative;">
    <canvas
        @ref="_backgroundCanvas"
        class="simulation-canvas simulation-background-canvas"
        aria-hidden="true"
        style="position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;">
    </canvas>

    <canvas
        @ref="_canvas"
        class="simulation-canvas simulation-trail-canvas"
        aria-label="Interactive Boids simulation"
        style="position: absolute; inset: 0; width: 100%; height: 100%;">
    </canvas>
</section>

@code {
    private ElementReference _backgroundCanvas;
    private ElementReference _canvas;

    private IJSObjectReference? _module;
    private DotNetObjectReference<Simulation>? _dotNetReference;

    protected override void OnInitialized()
    {
        VisualPreferences.Changed += HandleVisualPreferencesChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/simulationClient.js");

            _dotNetReference = DotNetObjectReference.Create(this);

            ConnectionStatus.Update("Connecting");

            await _module.InvokeVoidAsync(
                "connect",
                _dotNetReference,
                _backgroundCanvas,
                _canvas,
                Settings.WorldWidth,
                Settings.WorldHeight);

            await ApplyVisualPreferencesAsync();
        }
        catch
        {
            ConnectionStatus.Update("Disconnected");
            throw;
        }
    }

    [JSInvokable]
    public Task OnConnectionStatusChanged(string status)
    {
        return InvokeAsync(() =>
        {
            ConnectionStatus.Update(status);
            StateHasChanged();
        });
    }

    private void HandleVisualPreferencesChanged()
    {
        _ = InvokeAsync(ApplyVisualPreferencesAsync);
    }

    private async Task ApplyVisualPreferencesAsync()
    {
        if (_module is null)
        {
            return;
        }

        var preferences = VisualPreferences.Current;

        try
        {
            await _module.InvokeVoidAsync(
                "setPreferences",
                preferences.BoidColor,
                preferences.BackgroundColor,
                preferences.ShowTrails);
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit disconnected while applying preferences.
        }
    }

    public async ValueTask DisposeAsync()
    {
        VisualPreferences.Changed -= HandleVisualPreferencesChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disconnect");
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit is already disconnected.
            }

            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit is already disconnected.
            }
        }

        _dotNetReference?.Dispose();
    }
}