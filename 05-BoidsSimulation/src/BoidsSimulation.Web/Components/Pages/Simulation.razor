
@using BoidsSimulation.Core.Models
@page "/simulation"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@implements IAsyncDisposable

@inject IJSRuntime JS
@inject SimulationSettings Settings
@inject BoidsSimulation.Web.Services.SimulationConnectionStatus ConnectionStatus

<section class="simulation-viewport">
    <canvas
        @ref="_canvas"
        class="simulation-canvas"
        aria-label="Interactive Boids simulation">
    </canvas>
</section>

@code {
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Simulation>? _dotNetReference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/simulationClient.js");

            _dotNetReference = DotNetObjectReference.Create(this);

            ConnectionStatus.Update("Connecting");
            
            await _module.InvokeVoidAsync(
                "connect",
                _dotNetReference,
                _canvas,
                Settings.WorldWidth,
                Settings.WorldHeight);
        }
        catch
        {
            ConnectionStatus.Update("Disconnected");
            throw;
        }
    }

    [JSInvokable]
    public Task OnConnectionStatusChanged(string status)
    {
        return InvokeAsync(() =>
        {
            ConnectionStatus.Update(status);
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disconnect");
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit is already disconnected.
            }

            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser circuit is already disconnected.
            }
        }

        _dotNetReference?.Dispose();
    }
}
