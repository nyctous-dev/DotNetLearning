<div class="card mb-3">
    <div class="card-body">
        <h3 class="card-title">Boid Status</h3>
        <p>Boids: @BoidCount</p>
        <p>Status: @(IsRunning ? "Running" : "Paused")</p>
    </div>
</div>

@code {
    [Parameter]
    public int BoidCount { get; set; }

    [Parameter]
    public bool IsRunning { get; set; }
}